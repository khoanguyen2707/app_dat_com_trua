// Prisma 7 — generator client mới, output ra src/generated/prisma (giống convention repo mẫu)
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7: connection URL chuyển sang prisma.config.ts (datasource.url).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum DishCategory {
  MAIN // món ăn (đồng giá / suất)
  DRINK // đồ uống (tính tiền riêng theo giá)
}

enum PaymentStatus {
  UNPAID // chưa trả
  PENDING // user đã báo chuyển khoản, chờ admin xác nhận
  PAID // admin đã xác nhận nhận tiền
}

/// Tài khoản đăng nhập = thành viên ăn cơm
model User {
  id         String      @id @default(cuid())
  email      String      @unique @db.VarChar(150)
  password   String      @db.VarChar(255)
  fullName   String      @db.VarChar(150)
  role       Role        @default(USER)
  active     Boolean     @default(true)
  color      String?     @db.VarChar(20)
  teamsEmail String?     @db.VarChar(150) // email/Object ID Microsoft 365 để @mention trong Teams (người đi lấy cơm)
  pickupOptOut Boolean   @default(false) // true = miễn đi lấy cơm (không bao giờ bị bốc trong xoay tua)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orders     Order[]
  orderItems OrderItem[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  pickups    PickupAssignment[]
  dispatches DailyDispatch[]

  @@map("users")
}

/// Mỗi tuần đặt cơm (tuần hiện tại + lịch sử)
model Week {
  id        String    @id @default(cuid())
  label     String    @db.VarChar(100) // "15/6/2026 - 20/6/2026"
  startDate DateTime? // Ngày Thứ 2 đầu tuần (mốc để khoá tick theo ngày/giờ VN). Null = không khoá.
  unitPrice Int       @default(25000)
  dayMenu   Json? // Thực đơn bán theo ngày: { "mon": [dishId, ...], ... }. Ngày có list -> picker chỉ hiện món đó; ngày trống -> full catalog.
  isActive   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orders     Order[]
  orderItems OrderItem[]

  @@map("weeks")
}

/// Đăng ký ăn của 1 user trong 1 tuần (tích ngày)
model Order {
  id        String   @id @default(cuid())
  weekId    String
  userId    String
  mon       Boolean  @default(false)
  tue       Boolean  @default(false)
  wed       Boolean  @default(false)
  thu       Boolean  @default(false)
  fri       Boolean  @default(false)
  sat       Boolean  @default(false)
  sun       Boolean  @default(false)
  notes     Json? // Ghi chú đặt cơm theo ngày: { "mon": "ít cơm, không hành", ... }
  paid      Boolean       @default(false) // = (paymentStatus == PAID), giữ cho tương thích
  paymentStatus PaymentStatus @default(UNPAID)
  reportedAt    DateTime? // lúc user bấm "đã chuyển khoản"
  paidAt        DateTime? // lúc admin xác nhận
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weekId, userId])
  @@map("orders")
}

/// Thông báo trong app (chuông ở header) — báo chuyển khoản / xác nhận thanh toán.
model Notification {
  id        String   @id @default(cuid())
  userId    String // người nhận
  type      String   @db.VarChar(30) // PAYMENT_PENDING | PAYMENT_CONFIRMED | PAYMENT_REJECTED
  title     String   @db.VarChar(150)
  body      String   @db.VarChar(255)
  read      Boolean  @default(false)
  weekId    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

/// Một thiết bị/trình duyệt đã bật thông báo đẩy. Một user có nhiều thiết bị.
/// `endpoint` là URL push service do trình duyệt cấp — dùng làm khoá duy nhất.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String   @db.VarChar(255)
  auth       String   @db.VarChar(255)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  /// Lần cuối trình duyệt xác nhận subscription còn sống (mỗi lần mở app).
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Trạng thái đã nhắc "sắp tới giờ chốt" trong một ngày — chống bắn trùng khi
/// Power Automate gọi lại. Tách khỏi DailyDispatch vì đó là việc gửi đơn cho quán.
model CutoffReminder {
  date      String   @id @db.VarChar(10) // "YYYY-MM-DD" theo lịch VN
  sentAt    DateTime @default(now())
  /// Số người thực sự nhận được nhắc (để xem lại khi nghi ngờ flow chạy sai).
  notified  Int      @default(0)

  @@map("cutoff_reminders")
}

/// Thực đơn món ăn + đồ uống (admin quản lý)
model Dish {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(150)
  description String?      @db.VarChar(255)
  emoji       String?      @db.VarChar(10)
  price       Int          @default(25000)
  category    DishCategory @default(MAIN)
  /// Món "luôn có": tự xuất hiện trong thực đơn mọi ngày admin ĐÃ đăng (không mở ngày chưa đăng).
  pinned      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderItems  OrderItem[]
  distinctA   DishDistinctPair[] @relation("DistinctA")
  distinctB   DishDistinctPair[] @relation("DistinctB")

  @@map("dishes")
}

/// Cặp món admin đã xác nhận là KHÁC NHAU dù tên gần giống → không báo trùng lại. Luôn lưu aId < bId.
model DishDistinctPair {
  aId       String
  bId       String
  createdAt DateTime @default(now())
  a         Dish     @relation("DistinctA", fields: [aId], references: [id], onDelete: Cascade)
  b         Dish     @relation("DistinctB", fields: [bId], references: [id], onDelete: Cascade)

  @@id([aId, bId])
  @@map("dish_distinct_pairs")
}

/// Món/đồ uống cụ thể 1 user chọn cho 1 ngày trong tuần (mix nhiều món; nước có số lượng).
/// Suất cơm 25k vẫn tính theo Order.<ngày>; OrderItem.MAIN chỉ là chi tiết, DRINK mới cộng tiền.
model OrderItem {
  id        String   @id @default(cuid())
  weekId    String
  userId    String
  dishId    String
  day       String   @db.VarChar(3) // 'mon'..'sun'
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([weekId, userId])
  @@map("order_items")
}

/// Lịch sử "lượt đi lấy cơm" — xoay tua công bằng giữa những người có đặt cơm.
/// date = ngày theo lịch VN ("YYYY-MM-DD"); @unique để 1 ngày chỉ chốt đúng 1 người
/// (idempotent: Power Automate gọi lại trong ngày vẫn ra cùng người, không bốc lại).
/**
 * Trạng thái gửi đơn cho quán trong một ngày.
 *
 * Tách khỏi PickupAssignment vì có ngày không bốc người đi lấy cơm nhưng vẫn cần
 * biết đơn đã gửi hay chưa.
 */
model DailyDispatch {
  id         String    @id @default(cuid())
  date       String    @unique @db.VarChar(10) // "YYYY-MM-DD" theo lịch VN
  sentAt     DateTime? // lúc có người bấm "đã gửi quán"
  sentById   String?
  reminded   String    @default("idle") // mức nhắc cao nhất đã bắn: idle | first | second | escalate
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sentBy     User?     @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@map("daily_dispatch")
}

model PickupAssignment {
  id        String   @id @default(cuid())
  date      String   @unique @db.VarChar(10)
  userId    String
  weekId    String? // tuần lúc chốt (để tham chiếu, không bắt buộc)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pickup_assignments")
}

/// Thông tin thanh toán (singleton, admin chỉnh sửa)
model PaymentConfig {
  id            String   @id @default("default")
  groupName     String   @default("Nhóm văn phòng") @db.VarChar(150)
  bankName      String   @default("TPBank") @db.VarChar(100)
  bankBin       String   @default("970423") @db.VarChar(20)
  accountNumber String   @default("10001002966") @db.VarChar(50)
  accountHolder String   @default("NGUYEN ANH KHOA") @db.VarChar(150)
  /// Nợ vượt ngưỡng này (đồng) thì khoá đặt cơm. 0 = tắt rule.
  debtLimit     Int      @default(200000)
  updatedAt     DateTime @updatedAt

  @@map("payment_config")
}
